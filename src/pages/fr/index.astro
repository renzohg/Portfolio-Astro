                >
                  <div class="icon">
                    <img src="/SVG/npm.svg" alt="npm icon" loading="lazy" />
                    <p>npm</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://visualstudio.microsoft.com/"
                  target="_blank"
                >
