                  target="_blank"
                >
                  <div class="icon">
                    <img
                      src="/SVG/python.svg"
                      alt="Python icon"
                      loading="lazy"
                    />
                    <p>Python</p>
                  </div>
                </a>
              </div>
            </div>
            <div class="containerothers">
              <div class="containerhr">
                <h2 id="other">{t("other")}</h2>
                <hr />
              </div>
              <div class="others">
                <a
                  draggable="false"
                  href="https://git-scm.com/"
                  target="_blank"
                >
                  <div class="icon">
                    <img src="/SVG/git.svg" alt="Git icon" loading="lazy" />
