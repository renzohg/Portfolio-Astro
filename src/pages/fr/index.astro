                      loading="lazy"
                    />
                    <p>JavaScript</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://reactjs.org/"
                  target="_blank"
                >
                  <div class="icon">
                    <img src="/SVG/react.svg" alt="React icon" loading="lazy" />
                    <p>React</p>
                  </div>
                </a>
                <a draggable="false" href="https://vitejs.dev/" target="_blank">
                  <div class="icon">
                    <img src="/SVG/vite.svg" alt="Vite icon" loading="lazy" />
                    <p>Vite</p>
                  </div>
                </a>
                <a draggable="false" href="https://vue.io/" target="_blank">
                  <div class="icon">
                    <img src="/SVG/vue.svg" alt="Vue icon" loading="lazy" />
                    <p>Vue</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://astro.build/"
                  target="_blank"
                >
                  <div class="icon">
                    <img src="/SVG/astro.svg" alt="Astro icon" loading="lazy" />
                    <p>Astro</p>
                  </div>
                </a>
              </div>
            </div>
            <div class="containerbackend">
              <div class="containerhr">
                <h2>Backend</h2>
                <hr />
              </div>
              <div class="backend">
                <a draggable="false" href="https://nodejs.org/" target="_blank">
                  <div class="icon">
                    <img
                      src="/SVG/nodejs.svg"
                      alt="Node.js icon"
                      loading="lazy"
                    />
                    <p>Node.js</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://expressjs.com/"
                  target="_blank"
                >
                  <div class="icon">
                    <img
                      id="skills-express-icon"
                      src="/SVG/express.svg"
                      alt="Express.js icon"
                      loading="lazy"
                    />
                    <p>Express.js</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://www.mongodb.com/"
                  target="_blank"
                >
                  <div class="icon">
                    <img
                      src="/SVG/mongodb.svg"
                      alt="MongoDB icon"
