                    <img src="/SVG/css.svg" alt="CSS icon" loading="lazy" />
                    <p>CSS</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://getbootstrap.com/"
                  target="_blank"
                >
                  <div class="icon">
                    <img
                      src="/SVG/bootstrap.svg"
                      alt="Bootstrap icon"
                      loading="lazy"
                    />
                    <p>Bootstrap</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://tailwindcss.com/"
                  target="_blank"
                >
                  <div class="icon">
                    <img
                      src="/SVG/tailwind.svg"
                      alt="Tailwind icon"
                      loading="lazy"
                    />
                    <p>Tailwind</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://developer.mozilla.org/es/docs/Web/JavaScript"
                  target="_blank"
                >
                  <div class="icon">
                    <img
                      src="/SVG/javascript.svg"
