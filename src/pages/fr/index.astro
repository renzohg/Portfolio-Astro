---
import Navbar from "./_navbar.jsx";
import "../../assets/main.css";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// {t('nombre-del-texto')}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Explore my complete web development portfolio and discover how I transform ideas into impactful digital experiences."
    />
    <link rel="shortcut icon" type="image/x-icon" href="/icono.ico" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      media="all"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      />
    </noscript>
    <meta
      name="google-site-verification"
      content="JcuizXqdDm2PVITIUiiqoovgPaPb9JCV0dbQ7IhlI28"
    />
    <title id="title-site">{t("title-site")}</title>
  </head>
  <body>
    <Navbar client:load />
    <div class="cursor-dot" data-cursor-dot></div>
    <div class="cursor-outline" data-cursor-outline></div>
    <div class="line"></div>
    <div class="inicio">
      <div class="containerTitle">
        <div class="titleText">
          <div class="available-badge">
            <span class="green-dot"></span>
            {t("available")}
          </div>
          <h1 id="title">{t("title")}</h1>
          <h2 id="typing-text">{t("typing-text")}</h2>
          <div class="social-links-title">
            <a
              draggable="false"
              href="https://www.linkedin.com/in/renzo-roggiapane-bb4520279/"
              target="_blank"
              class="social-icon"
            >
              <img
                alt="link_linkedin"
                id="linkedin-icon"
                src="/SVG/linkedin_white.svg"
                style="width: 19.30px; height: auto"
              /> LinkedIn
            </a>
            <a
              draggable="false"
              href="https://github.com/renzohg"
              target="_blank"
              class="social-icon"
            >
              <img
                alt="link_github"
                id="github-icon"
                src="/SVG/github_white.svg"
                style="width: 19.30px; height: auto"
              /> GitHub
            </a>
          </div>
        </div>
      </div>
      <div class="containerImg">
        <div class="logo-frame">
          <img src="/logoRenzo.webp" alt="Renzo Logo" />
        </div>
      </div>
      <div class="scroll-down">
        <a href="#about" aria-label="Ir a la sección Acerca de"
          ><i class="fas fa-chevron-down"></i></a
        >
      </div>
    </div>
    <div class="inicio2">
      <div id="about">
        <div class="containerAbout" id="aboutSection">
          <div class="aboutText">
            <h1 id="about-me">{t("about-me")}</h1>
            <h2 id="about-me-text">
              {t("about-me-text")}
            </h2>
          </div>
          <div class="studies">
            <h1 id="studies">{t("studies")}</h1>
            <h2 id="studies-text">
              {t("studies-text")}
            </h2>
          </div>
        </div>
        <div class="certifications">
          <img
            src="../webdesing.webp"
            alt="Responsive Web Design"
            class="image"
            loading="lazy"
          />
          <img
            src="/git-github.webp"
            alt="Git & GitHub"
            class="image"
            loading="lazy"
          />
          <img
            src="/comunicacion.webp"
            alt="Communication Efficace"
            class="image"
            loading="lazy"
          />
        </div>
        <div id="imageModal" class="modal">
          <span class="close"
            ><img src="/SVG/close_white.svg" alt="Close Modal" /></span
          >
          <img
            class="modal-content modalImage"
            alt="Certification Responsive Web Design"
          />
          <div id="caption"></div>
        </div>
      </div>
    </div>
    <div class="inicio3">
      <div id="projects">
        <h1 id="my-projects">{t("my-projects")}</h1>
        <div class="containerProyectos">

          <!-- ==================== ROGEN AUTOS ==================== -->
          <div class="cardProject">
            <div class="containerImage">
              <div class="carousel">
                <div class="carousel-images">
                  <img draggable="false" src="/Pages/www.rogen-autos.com1.webp" alt="Rogen Autos" class="active" />
                  <img draggable="false" src="/Pages/www.rogen-autos.com2.webp" alt="Rogen Autos" />
                  <img draggable="false" src="/Pages/www.rogen-autos.com3.webp" alt="Rogen Autos" />
                </div>
                <div class="carousel-dots">
                  <span class="dot active"></span>
                  <span class="dot"></span>
                  <span class="dot"></span>
                </div>
              </div>
            </div>
            <div class="containerCard">
              <div class="containerTextCard">
                <h2 id="rogen-autos">{t("rogen-autos")}</h2>
                <p id="rogen-autos-text">{t("rogen-autos-text")}</p>
              </div>
              <div class="containerIconsCard">
                <div class="tech-icons">
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/html5.svg" alt="HTML5" loading="lazy" /><span class="tech-tag-label">HTML</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/css.svg" alt="CSS" loading="lazy" /><span class="tech-tag-label">CSS</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/mongodb.svg" alt="MongoDB" loading="lazy" /><span class="tech-tag-label">MongoDB</span></span>
                  <span class="tech-tag"><img id="first-project-express-icon" class="icon-project-tec" src="/SVG/express.svg" alt="Express" loading="lazy" /><span class="tech-tag-label">Express</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/react.svg" alt="React" loading="lazy" /><span class="tech-tag-label">React</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/nodejs.svg" alt="Node.js" loading="lazy" /><span class="tech-tag-label">Node.js</span></span>
                </div>
              </div>
              <div class="buttons">
                <a draggable="false" href="https://rogen-autos.com" target="_blank" class="view-project"><i class="fas fa-external-link-alt"></i> {t("visit")}</a>
              </div>
            </div>
          </div>

          <!-- ==================== FOOD STORE ==================== -->
          <div class="cardProject">
            <div class="containerImage">
              <div class="carousel">
                <div class="carousel-images">
                  <img draggable="false" src="/Pages/foodstore1.webp" alt="Food-Store" class="active" />
                  <img draggable="false" src="/Pages/foodstore2.webp" alt="Food-Store" />
                  <img draggable="false" src="/Pages/foodstore3.webp" alt="Food-Store" />
                </div>
                <div class="carousel-dots">
                  <span class="dot active"></span>
                  <span class="dot"></span>
                  <span class="dot"></span>
                </div>
              </div>
            </div>
            <div class="containerCard">
              <div class="containerTextCard">
                <h2 id="food-store">{t("food-store")}</h2>
                <p id="food-store-text">{t("food-store-text")}</p>
              </div>
              <div class="containerIconsCard">
                <div class="tech-icons">
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/html5.svg" alt="HTML5" loading="lazy" /><span class="tech-tag-label">HTML</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/css.svg" alt="CSS" loading="lazy" /><span class="tech-tag-label">CSS</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/mongodb.svg" alt="MongoDB" loading="lazy" /><span class="tech-tag-label">MongoDB</span></span>
                  <span class="tech-tag"><img id="food-store-express-icon" class="icon-project-tec" src="/SVG/express.svg" alt="Express" loading="lazy" /><span class="tech-tag-label">Express</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/react.svg" alt="React" loading="lazy" /><span class="tech-tag-label">React</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/nodejs.svg" alt="Node.js" loading="lazy" /><span class="tech-tag-label">Node.js</span></span>
                </div>
              </div>
              <div class="buttons">
                <a draggable="false" href="https://github.com/renzohg/Food-Store-Frontend" target="_blank" class="github-link"><i class="fab fa-github"></i> Frontend</a>
                <a draggable="false" href="https://github.com/renzohg/Food-Store-Backend" target="_blank" class="github-link"><i class="fab fa-github"></i> Backend</a>
              </div>
            </div>
          </div>

          <!-- ==================== RGLIBRARY ==================== -->
          <div class="cardProject">
            <div class="containerImage">
              <div class="carousel">
                <div class="carousel-images">
                  <img draggable="false" src="/Pages/rglibrary.netlify.app1.webp" alt="RgLibrary" class="active" />
                  <img draggable="false" src="/Pages/rglibrary.netlify.app2.webp" alt="RgLibrary" />
                  <img draggable="false" src="/Pages/rglibrary.netlify.app3.webp" alt="RgLibrary" />
                </div>
                <div class="carousel-dots">
                  <span class="dot active"></span>
                  <span class="dot"></span>
                  <span class="dot"></span>
                </div>
              </div>
            </div>
            <div class="containerCard">
              <div class="containerTextCard">
                <h2 id="rglibrary">{t("rglibrary")}</h2>
                <p id="rglibrary-text">{t("rglibrary-text")}</p>
              </div>
              <div class="containerIconsCard">
                <div class="tech-icons">
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/html5.svg" alt="HTML5" loading="lazy" /><span class="tech-tag-label">HTML</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/css.svg" alt="CSS" loading="lazy" /><span class="tech-tag-label">CSS</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/react.svg" alt="React" loading="lazy" /><span class="tech-tag-label">React</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/vite.svg" alt="Vite" loading="lazy" /><span class="tech-tag-label">Vite</span></span>
                  <span class="tech-tag"><img class="icon-project-tec" src="/SVG/tailwind.svg" alt="Tailwind" loading="lazy" /><span class="tech-tag-label">Tailwind</span></span>
                </div>
              </div>
              <div class="buttons">
                <a draggable="false" href="https://rglibrary.netlify.app/" target="_blank" class="view-project"><i class="fas fa-external-link-alt"></i> {t("visit")}</a>
                <a draggable="false" href="https://github.com/renzohg/RgLibrary-React" target="_blank" class="github-link"><i class="fab fa-github"></i> GitHub</a>
              </div>
            </div>
          </div>

          <!-- ==================== SHOW MORE BUTTON ==================== -->
          <div class="show-more-container">
            <button class="show-more-button" id="show-more-btn"
              data-show-text="Voir plus de projets"
              data-hide-text="Masquer les projets">
              <span class="show-more-text">Voir plus de projets</span> <i class="fas fa-chevron-down"></i>
            </button>
          </div>

          <!-- ==================== EXTRA PROJECTS ==================== -->
          <div class="extra-projects" id="extra-projects">

            <div class="project-mini-card">
              <div class="mini-card-header">
                <svg class="folder-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#f5a623" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                <div class="mini-card-actions">
                  <a href="https://cristo-obrero-astro.netlify.app/" target="_blank" title="Visit"><i class="fas fa-external-link-alt"></i></a>
              <a href="https://github.com/renzohg/Cristo-Obrero-Astro" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
                </div>
              </div>
              <h3>Cristo Obrero</h3>
              <p>Site Web informatif de l'institution éducative Cristo Obrero.</p>
              <div class="mini-tech-tags">
                <span class="mini-tech-tag">HTML</span>
                <span class="mini-tech-tag">CSS</span>
                <span class="mini-tech-tag">Astro</span>
              </div>
            </div>

            <div class="project-mini-card">
              <div class="mini-card-header">
                <svg class="folder-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#f5a623" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                <div class="mini-card-actions">
                  <a href="https://fronesis.netlify.app/" target="_blank" title="Visit"><i class="fas fa-external-link-alt"></i></a>
                </div>
              </div>
              <h3>Fronesis</h3>
              <p>Site web de services professionnels de développement web, axé sur la création de pages simples, réactives et optimisées pour le référencement.</p>
              <div class="mini-tech-tags">
                <span class="mini-tech-tag">HTML</span>
                <span class="mini-tech-tag">CSS</span>
                <span class="mini-tech-tag">JavaScript</span>
                <span class="mini-tech-tag">Astro</span>
              </div>
            </div>

            <div class="project-mini-card">
              <div class="mini-card-header">
                <svg class="folder-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#f5a623" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                <div class="mini-card-actions">
                  <a href="https://weather-app-renzo.netlify.app" target="_blank" title="Visit"><i class="fas fa-external-link-alt"></i></a>
              <a href="https://github.com/renzohg/Weather-app-Vue" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
                </div>
              </div>
              <h3>Weather App</h3>
              <p>Application météo avec consommation d'API.</p>
              <div class="mini-tech-tags">
                <span class="mini-tech-tag">HTML</span>
                <span class="mini-tech-tag">CSS</span>
                <span class="mini-tech-tag">Vue</span>
                <span class="mini-tech-tag">Tailwind</span>
              </div>
            </div>

            <div class="project-mini-card">
              <div class="mini-card-header">
                <svg class="folder-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#f5a623" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                <div class="mini-card-actions">
                  <a href="https://card-generator-renzo.netlify.app/" target="_blank" title="Visit"><i class="fas fa-external-link-alt"></i></a>
              <a href="https://github.com/renzohg/Card-generator" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
                </div>
              </div>
              <h3>Générateur de cartes</h3>
              <p>Formulaire simple pour générer une carte avec le texte saisi.</p>
              <div class="mini-tech-tags">
                <span class="mini-tech-tag">HTML</span>
                <span class="mini-tech-tag">CSS</span>
                <span class="mini-tech-tag">JavaScript</span>
                <span class="mini-tech-tag">React</span>
              </div>
            </div>

            <div class="project-mini-card">
              <div class="mini-card-header">
                <svg class="folder-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#f5a623" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                <div class="mini-card-actions">
                  <a href="https://test-ig-login.netlify.app/" target="_blank" title="Visit"><i class="fas fa-external-link-alt"></i></a>
                </div>
              </div>
              <h3>Connexion Instagram</h3>
              <p>Recréation du formulaire de connexion Instagram, à des fins éducatives et pratiques.</p>
              <div class="mini-tech-tags">
                <span class="mini-tech-tag">HTML</span>
                <span class="mini-tech-tag">CSS</span>
                <span class="mini-tech-tag">JavaScript</span>
              </div>
            </div>

          </div><!-- /extra-projects -->
        </div>
      </div>

      <div class="inicio4">
        <div id="skills">
          <h1 id="skills-title">{t("skills-title")}</h1>
          <div class="grid-container">
            <div class="containerfrontend">
              <div class="containerhr">
                <h2>Frontend</h2>
                <hr />
              </div>
              <div class="frontend">
                <a
                  draggable="false"
                  href="https://html.spec.whatwg.org/"
                  target="_blank"
                >
                  <div class="icon">
                    <img src="/SVG/html5.svg" alt="HTML5 icon" loading="lazy" />
                    <p>HTML5</p>
                  </div>
                </a>
                <a
                  draggable="false"
                  href="https://www.w3.org/Style/CSS/"
                  target="_blank"
