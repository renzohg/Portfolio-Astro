---
import Navbar from "../components/navbar.jsx";
import "../assets/main.css";

import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { ui, defaultLang } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// {t('nombre-del-texto')}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Explore my complete web development portfolio and discover how I transform ideas into impactful digital experiences."
    />
    <link rel="shortcut icon" type="image/x-icon" href="/icono.ico" />
    <meta
      name="google-site-verification"
      content="JcuizXqdDm2PVITIUiiqoovgPaPb9JCV0dbQ7IhlI28"
    />
    <title id="title-site" data-i18n="title-site">{t("title-site")}</title>
  </head>
  <body>
    <Navbar client:load />
    <div class="cursor-dot" data-cursor-dot></div>
    <div class="cursor-outline" data-cursor-outline></div>
    <div class="line"></div>

    <main>
      <div class="inicio">
        <div class="containerTitle">
          <div class="titleText">
            <div class="available-badge">
              <span class="green-dot"></span>
              <span data-i18n="available">{t("available")}</span>
            </div>
            <h1 id="title" data-i18n="title">{t("title")}</h1>
            <h2 id="typing-text" data-i18n="typing-text">{t("typing-text")}</h2>
            <div class="social-links-title">
              <a
                draggable="false"
                href="https://www.linkedin.com/in/renzo-roggiapane-bb4520279/"
                target="_blank"
                class="social-icon"
              >
                <span
                  class="icon-linkedin"
                  style="width: 19.30px; height: 19.30px; margin-right: 5px;"
                ></span> LinkedIn
              </a>
              <a
                draggable="false"
                href="https://github.com/renzohg"
                target="_blank"
                class="social-icon"
              >
                <span
                  class="icon-github"
                  style="width: 19.30px; height: 19.30px"></span> GitHub
              </a>
            </div>
          </div>
        </div>
        <div class="containerImg">
          <div class="logo-frame">
            <img src="/logoRenzo.webp" alt="Renzo Logo" />
          </div>
        </div>
        <div class="scroll-down">
          <a href="#about" aria-label="Ir a la sección Acerca de"
            ><span
              class="icon-arrow fa-chevron-down"
              style="width: 50px; height: 50px;"></span></a
          >
        </div>
      </div>
      <div class="inicio2">
        <div id="about">
          <div class="containerAbout" id="aboutSection">
            <div class="aboutText">
              <h1 id="about-me" data-i18n="about-me">{t("about-me")}</h1>
              <h2 id="about-me-text" data-i18n="about-me-text">
                {t("about-me-text")}
              </h2>
            </div>
            <div class="studies">
              <h1 id="studies" data-i18n="studies">{t("studies")}</h1>
              <h2 id="studies-text" data-i18n="studies-text">
                {t("studies-text")}
              </h2>
            </div>
          </div>
          <div class="certifications">
            <img
              src="webdesing.webp"
              alt="Responsive Web Design"
              class="image"
              loading="lazy"
            />
            <img
              src="/git-github.webp"
              alt="Git & GitHub"
              class="image"
              loading="lazy"
            />
            <img
              src="/comunicacion.webp"
              alt="Effective Communication"
              class="image"
              loading="lazy"
            />
