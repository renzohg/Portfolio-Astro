<script define:vars={{ ui, defaultLang }}>
  window.uiTranslations = ui;
  window.defaultLang = defaultLang;

  let currentLang = localStorage.getItem("lang") || defaultLang;

  window.changeLanguage = function (lang) {
    currentLang = lang;
    localStorage.setItem("lang", lang);
    document.documentElement.lang = lang;

    const elements = document.querySelectorAll("[data-i18n]");
    elements.forEach((el) => {
      const key = el.getAttribute("data-i18n");
      if (ui[lang] && ui[lang][key]) {
        if (el.tagName === "TITLE") {
          el.textContent = ui[lang][key];
        } else {
          el.innerText = ui[lang][key];
        }
      }
    });

    const copyBtn = document.getElementById("copy-btn");
    if (copyBtn && ui[lang] && ui[lang]["copied"]) {
      copyBtn.setAttribute("data-copied-text", ui[lang]["copied"]);
    }

    const showMoreBtn = document.getElementById("show-more-btn");
    if (showMoreBtn && ui[lang]) {
      if (ui[lang]["show-more"]) {
        showMoreBtn.setAttribute("data-show-text", ui[lang]["show-more"]);
      }
      if (ui[lang]["hide-projects"]) {
        showMoreBtn.setAttribute("data-hide-text", ui[lang]["hide-projects"]);
      }
    }
  };

  if (currentLang !== defaultLang) {
    window.changeLanguage(currentLang);
  }
</script>
